# Dependencies
node_modules/
package-lock.json

# Build output
dist/
dist-test/
*.tsbuildinfo

# Session data (sensitive)
# NOTE: <session-path>/instances.json lives here and may contain proxy
# credentials (a `url` pin). Keep any relocated session directory ignored.
sessions/
test-sessions/
test-sessions-manual/
sessions-cli/
*.session.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pino-*.log*

# Environment variables
.env
.env.test
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Git worktrees
.worktrees/

# Proxy lists (contain credentials).
# Anchored to the repo root on purpose: unanchored patterns match at any depth
# and would silently swallow tests/fixtures/proxies.* .
/proxies.txt
/proxies.json
