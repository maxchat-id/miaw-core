# Test Environment Configuration
# Copy this file to .env.test and fill in your test values

# Enable verbose Baileys logging (default: false)
DEBUG=false

# Test bot instance ID
TEST_INSTANCE_ID=miaw-test-bot

# Directory for test session storage
TEST_SESSION_PATH=./test-sessions

# Test contact phone numbers (without + or spaces)
# Contact A: Primary test contact
TEST_CONTACT_PHONE_A=6281234567890

# Contact B: Secondary test contact (for forwarding, etc.)
TEST_CONTACT_PHONE_B=6289876543210

# Optional: Test group JID (format: 123456789@g.us)
# You can get this by receiving a group message and checking the 'from' field
TEST_GROUP_JID=

# Test timeouts (milliseconds)
TEST_CONNECT_TIMEOUT=60000
TEST_MESSAGE_TIMEOUT=30000

# Optional: a real proxy URL. When set, the proxy CLI integration tests add a
# live end-to-end reachability check against it; otherwise that single test is
# skipped. The rest of the proxy tests are fully offline.
# TEST_PROXY_URL=socks5h://user:pass@proxy.example.com:1080

# Optional: a real proxy list to exercise the CLI against. `/proxies.txt` is
# gitignored at the repo root for exactly this, so a vendor list with live
# credentials can live beside the code without risk of being committed.
#   npx miaw-cli proxy test-all --proxy-file ./proxies.txt --ip
# MIAW_PROXY_FILE=./proxies.txt

# Optional: opt in to the `call link` CLI test. Creating a call link mints a
# REAL, shareable WhatsApp artifact, so the test is skipped unless this is set.
# TEST_CALL_LINK=1

# ── Unattended manual runner (npm run test:manual) ──────────────────────────
# The runner normally prompts before every entry. These make it a real gate:
# prompts resolve to the defaults above, and it exits non-zero if any test
# failed. `npm run test:manual:auto` sets AUTO=1 for you.
# AUTO=1

# ⚠️  DANGER: also runs the entries marked `destructive` — leaving a group,
# deleting a catalog product, deleting a newsletter, removing a contact,
# changing settings that cannot be read back and so cannot be restored.
# These act on a REAL WhatsApp account. Leave unset unless you mean it.
# AUTO_DESTRUCTIVE=1

# Optional: how long `npm run test:viewonce` waits for a view-once message,
# in milliseconds. Unset or 0 means wait indefinitely (Ctrl-C to stop).
# VIEWONCE_TIMEOUT_MS=360000
